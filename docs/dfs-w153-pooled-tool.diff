+DETERMINATION_WORDS = 80   # W153 pooled variant (E6): the budget on a Determination
+
+
+def check_determination_budget(task, text, head, archive="", head_archive=""):
+    """A Determination over DETERMINATION_WORDS words is refused (W153 pooled variant, E6).
+
+    Judged on a node that is new in this commit or whose Determination changed since HEAD;
+    a Determination already at HEAD is history. A shelved Determination keeps its first
+    clause and `(archived.)`, so the stub is short and passes."""
+    bad = []
+    t = dfs_tree.with_archive(dfs_tree.parse(text, task), archive)
+    was = ({nd["id"]: nd for nd in
+            dfs_tree.with_archive(dfs_tree.parse(head, task), head_archive)["nodes"]}
+           if head else {})
+    for nd in t["nodes"]:
+        d = (nd["fields"].get("Determination") or "").strip()
+        n = len(d.split())
+        if n <= DETERMINATION_WORDS:
+            continue
+        old = was.get(nd["id"])
+        if old and (old["fields"].get("Determination") or "").strip() == d:
+            continue
+        bad.append("%s's Determination is %d words; the budget is %d. Keep the verdict, and "
+                   "move the evidence to the Evidence lines and the hand-off to the next "
+                   "node's Approach" % (nd["id"], n, DETERMINATION_WORDS))
+    return bad
+
